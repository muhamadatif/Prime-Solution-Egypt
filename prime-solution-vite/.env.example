# Brevo (https://www.brevo.com) configuration for the enquiry form.
# Copy this file to .env.local and fill in the values.

# Brevo API key (Dashboard -> SMTP & API -> API Keys)
BREVO_API_KEY=

# Verified sender address in Brevo (must be a validated sender)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Prime Support Solutions Website

# Team inbox that receives enquiries
BREVO_RECIPIENT_EMAIL=team@yourdomain.com
BREVO_RECIPIENT_NAME=Prime Support Solutions Team